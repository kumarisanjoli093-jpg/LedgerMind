# Hindsight Cloud (required for the hackathon memory demonstration)
HINDSIGHT_API_KEY=your_hindsight_api_key
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=ledgermind-gst

# Groq (recommended; optional fallback remains available without this)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Alternative recommended Groq model:
# GROQ_MODEL=qwen/qwen3-32b
